         completed=count == REPLAN_STEPS,
         success=success,
     )


+def _rebase_causal_h5_actions(pending: PendingTransition) -> np.ndarray:
+    """Express targets 6..10 relative to the observed B5 pose, as in training."""
+    actions = np.stack(pending.executed_model_targets).astype(np.float32, copy=True)
+    if len(actions) <= 5:
+        return actions
+    if pending.causal_mid_observation is None:
+        raise RuntimeError("cannot rebase an R10 causal chunk without its B5 observation")
+    start = np.asarray(pending.start_observation["observation/state"], dtype=np.float64)
+    midpoint = np.asarray(
+        pending.causal_mid_observation["observation/state"], dtype=np.float64
+    )
+    start_rotation = quaternion_xyzw_to_rotation_matrix(start[3:7])
+    midpoint_rotation = quaternion_xyzw_to_rotation_matrix(midpoint[3:7])
+    original_delta = quaternion_xyzw_to_rotation_matrix(actions[5:, 3:7])
+    target_rotation = original_delta @ start_rotation
+    rebased_rotation = target_rotation @ midpoint_rotation.T
+    actions[5:, :3] = start[:3] + actions[5:, :3] - midpoint[:3]
+    actions[5:, 3:7] = rotation_matrix_to_quaternion_xyzw(rebased_rotation)
+    return np.ascontiguousarray(actions)
+
